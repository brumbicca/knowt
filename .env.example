# knowt — copie para .env e preencha (nunca commitar .env)
KNOWT_ENV=development
KNOWT_DATA_DIR=./data
KNOWT_ORG_ID=default
# Token da API knowt (Bearer). Em produção na VPS deve existir.
# KNOWT_API_TOKEN=
# Senha do chat web em https://knowt.com.br/
# KNOWT_CHAT_PASSWORD=
# KNOWT_SECRET_KEY=
# Referências de segredo (valores reais só em runtime / cofre)
# KNOWT_SECRET_TINY_TOKEN=...

# --- Telegram (bot fino → bridge; ver docs/TELEGRAM.md) ---
# KNOWT_TELEGRAM_BOT_TOKEN=
# KNOWT_TELEGRAM_CHAT_IDS=          # vazio ou * = qualquer; senão ids separados por vírgula
# KNOWT_TELEGRAM_BRIDGE_URL=http://127.0.0.1:8766
# KNOWT_TELEGRAM_SOURCE_ID=tinyerp

# --- Mongo próprio (VPS knowt; só loopback) ---
# KNOWT_MONGO_URI=mongodb://127.0.0.1:27017
# KNOWT_MONGO_DB=knowt
# KNOWT_WHATSAPP_TOKEN=
# KNOWT_WHATSAPP_PHONE_NUMBER_ID=
# KNOWT_WHATSAPP_VERIFY_TOKEN=
# KNOWT_WHATSAPP_APP_SECRET=
# KNOWT_WHATSAPP_ALLOWLIST=         # E.164 digits; vazio ou * = qualquer
# KNOWT_WHATSAPP_SOURCE_ID=tinyerp

# --- Google Calendar + Tasks (ver docs/GOOGLE.md) ---
# KNOWT_GOOGLE_CLIENT_ID=
# KNOWT_GOOGLE_CLIENT_SECRET=
# KNOWT_GOOGLE_REDIRECT_URI=https://knowt.com.br/api/bridge/agenda/google/callback
# KNOWT_GOOGLE_TOKEN_PATH=          # default: {KNOWT_DATA_DIR}/google_tokens.json
# KNOWT_GOOGLE_STATE_PATH=          # default: {KNOWT_DATA_DIR}/google_oauth_state.json
